{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "resume.html",
      "use": "@vercel/static"
    },
    {
      "src": "Sanjay_Kumar_Resume.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/Sanjay_Kumar_Resume.pdf",
      "dest": "/Sanjay_Kumar_Resume.pdf",
      "headers": {
        "Content-Type": "application/pdf",
        "Content-Disposition": "attachment; filename=\"Sanjay_Kumar_Resume.pdf\""
      }
    },
    {
      "src": "/resume.html",
      "dest": "/resume.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
