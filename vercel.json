{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "resume.html",
      "use": "@vercel/static"
    },
    {
      "src": "Sanjay_Kumar_Resume.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/Sanjay_Kumar_Resume.pdf",
      "dest": "/api/resume.js"
    },
    {
      "src": "/resume.html",
      "dest": "/resume.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
